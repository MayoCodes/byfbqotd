  "prompt": "Which expression is equivalent to $(x-7)(x+2)$?",
  "choices": {
    "A": "$x^{2}-14$",
    "B": "$x^{2}+9x-14$",
    "C": "$x^{2}-5x-14$",
    "D": "$x^{2}-5x+14$"
