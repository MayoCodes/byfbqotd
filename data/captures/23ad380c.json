  "prompt": "Which expression is equivalent to $(3x^{2}+2x+8)-(x^{2}-4x+3)$?",
  "choices": {
    "A": "$2x^{2}+6x+11$",
    "B": "$2x^{2}-2x+11$",
    "C": "$4x^{2}+6x+5$",
