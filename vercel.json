{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.cjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/daily.js": {
      "includeFiles": "{data/daily-pool.json,public/question-bank.json}"
    }
  }
}
